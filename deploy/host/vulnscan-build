#!/bin/bash
# Fetch (or update) the vulnscan source from GitHub and rebuild the scanner image. Run as root.
set -euo pipefail
. /etc/vulnscan/config

# Only needed while the vulnscan repo is private. It has its own token because a fine-grained
# token only reaches one owner's repos, and this repo may have a different owner.
token=$(aws ssm get-parameter --region "$AWS_REGION" --name "$SSM_PREFIX/source-token" \
  --with-decryption --query Parameter.Value --output text 2>/dev/null || true)

# Same as vulnscan itself: the token reaches git through the environment, never .git/config.
gitauth() {
  if [ -z "$token" ]; then GIT_TERMINAL_PROMPT=0 git "$@"; return; fi
  GIT_TERMINAL_PROMPT=0 GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0=http.https://github.com/.extraheader \
    GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$token" | base64 -w0)" \
    git "$@"
}

src=/opt/vulnscan-src
if [ -d "$src/.git" ]; then
  gitauth -C "$src" fetch --depth 1 origin "$VULNSCAN_SOURCE_REF"
  git -C "$src" reset --hard FETCH_HEAD
else
  gitauth clone --depth 1 --branch "$VULNSCAN_SOURCE_REF" "https://github.com/$VULNSCAN_SOURCE_REPO.git" "$src"
fi

# --pull picks up security fixes in the base image; the tools themselves stay pinned.
docker build --pull -t vulnscan:latest "$src"
install -m 755 "$src/deploy/host/vulnscan" /usr/local/bin/vulnscan
# Strix's pentest sandbox, for `vulnscan validate`. It runs on the host daemon, so it's
# pulled here (not into the image); the wrapper builds STRIX_IMAGE from this tag.
docker pull --quiet ghcr.io/usestrix/strix-sandbox:1.3.0

# The dashboard (docs/operations.md): recreated on every build so it runs the new image.
# Read-only scans mount, no tokens, published on the host's loopback only (reach it with
# Session Manager port forwarding). Its own network keeps the containers on the default
# bridge, such as Strix's sandbox running a scanned repo's code, from reaching it.
docker network inspect vulnscan-dashboard >/dev/null 2>&1 || docker network create vulnscan-dashboard >/dev/null
docker rm -f vulnscan-dashboard >/dev/null 2>&1 || true
docker run -d --name vulnscan-dashboard --restart unless-stopped --init \
  --cap-drop ALL --security-opt no-new-privileges --read-only \
  --memory 512m --pids-limit 64 --network vulnscan-dashboard -p 127.0.0.1:8080:8080 \
  -v /var/lib/vulnscan/scans:/var/lib/vulnscan/scans:ro \
  vulnscan:latest dashboard --host 0.0.0.0 --port 8080 >/dev/null

docker image prune -f
docker builder prune -f

# Keep this script itself current too: first boot installs it once, and changes to it
# otherwise never reach the instance. A rename, so this running copy is left untouched;
# the new one takes effect from the next run.
install -m 755 "$src/deploy/host/vulnscan-build" /usr/local/bin/vulnscan-build.new
mv -f /usr/local/bin/vulnscan-build.new /usr/local/bin/vulnscan-build
