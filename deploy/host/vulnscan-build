#!/bin/bash
# Fetch (or update) the vulnscan source from GitHub and rebuild the scanner image. Run as root.
set -euo pipefail
. /etc/vulnscan/config

# Only needed while the vulnscan repo is private. It has its own token because a fine-grained
# token only reaches one owner's repos, and this repo may have a different owner.
token=$(aws ssm get-parameter --region "$AWS_REGION" --name "$SSM_PREFIX/source-token" \
  --with-decryption --query Parameter.Value --output text 2>/dev/null || true)

# Same as vulnscan itself: the token reaches git through the environment, never .git/config.
gitauth() {
  if [ -z "$token" ]; then GIT_TERMINAL_PROMPT=0 git "$@"; return; fi
  GIT_TERMINAL_PROMPT=0 GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0=http.https://github.com/.extraheader \
    GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$token" | base64 -w0)" \
    git "$@"
}

src=/opt/vulnscan-src
if [ -d "$src/.git" ]; then
  gitauth -C "$src" fetch --depth 1 origin "$VULNSCAN_SOURCE_REF"
  git -C "$src" reset --hard FETCH_HEAD
else
  gitauth clone --depth 1 --branch "$VULNSCAN_SOURCE_REF" "https://github.com/$VULNSCAN_SOURCE_REPO.git" "$src"
fi

# --pull picks up security fixes in the base image; the tools themselves stay pinned.
docker build --pull -t vulnscan:latest "$src"
install -m 755 "$src/deploy/host/vulnscan" /usr/local/bin/vulnscan
# Strix's pentest sandbox, for `vulnscan validate`. It runs on the host daemon, so it's
# pulled here (not into the image); this tag must match STRIX_IMAGE in the Dockerfile.
docker pull --quiet ghcr.io/usestrix/strix-sandbox:1.3.0
docker image prune -f
docker builder prune -f
