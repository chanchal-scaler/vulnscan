#!/bin/bash
# Run vulnscan in a throwaway container. Run as root, e.g. `vulnscan scan your-org/repo`.
# The host fetches the tokens with the instance role. The container gets no AWS access
# (IMDS hop limit 1), no Linux capabilities, and only the reports directory.
set -euo pipefail
. /etc/vulnscan/config

param() {
  aws ssm get-parameter --region "$AWS_REGION" --name "$SSM_PREFIX/$1" \
    --with-decryption --query Parameter.Value --output text
}
# A classic token reaches every org its user can read, so one covers all of VULNSCAN_GITHUB_ORG.
GITHUB_TOKEN=$(param github-token)
CLAUDE_CODE_OAUTH_TOKEN=$(param claude-token)
export GITHUB_TOKEN CLAUDE_CODE_OAUTH_TOKEN VULNSCAN_GITHUB_ORG

# Remove containers left by earlier scans whose session ended before they finished.
docker container prune -f --filter label=vulnscan >/dev/null

# Detached, so the scan keeps running if the Session Manager session ends (the account
# caps sessions at 60 minutes); this script just streams its output.
# -e NAME without a value copies it from this environment, keeping tokens off the command
# line; the timeouts are only passed when set, e.g. VULNSCAN_TOOL_TIMEOUT=3600 vulnscan scan ...
# --memory leaves ~2 GB for the host on an 8 GB instance.
cid=$(docker run -d --init --label vulnscan \
  --cap-drop ALL --security-opt no-new-privileges \
  --memory 6g --pids-limit 1024 \
  -e GITHUB_TOKEN -e CLAUDE_CODE_OAUTH_TOKEN -e VULNSCAN_GITHUB_ORG \
  -e VULNSCAN_TOOL_TIMEOUT -e VULNSCAN_TRIAGE_TIMEOUT \
  -v /var/lib/vulnscan/scans:/var/lib/vulnscan/scans \
  vulnscan:latest "$@")
id=${cid:0:12}
echo "[vulnscan] running in container $id; it keeps going if this session ends (reattach: docker logs -f $id)" >&2
trap 'echo >&2; echo "[vulnscan] stopped following; the scan continues (reattach: docker logs -f $id)" >&2; exit 130' INT
docker logs -f "$cid" || true
code=$(docker wait "$cid")
docker rm "$cid" >/dev/null
exit "$code"
